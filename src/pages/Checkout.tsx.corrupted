import { useState, useEffect } from "react";
import { useCart } from "@/lib/cart-context";
import { useNavigate } from "react-router";
import { trpc } from "@/providers/trpc";
import { ArrowLeft, Lock, CreditCard, AlertCircle, Package, Store, Truck } from "lucide-react";
import SquarePaymentForm from "@/components/SquarePaymentForm";

function getDeliveryOptions(postcode: string) {
  if (postcode === "4870") {
    return [
      { id: "free_local", label: "Free Local Delivery", desc: "Free delivery within Cairns", cost: 0, icon: "truck", eta: "1-2 business days" },
      { id: "click_collect", label: "Click & Collect", desc: "Pick up from 22 Craven St, Redlynch", cost: 0, icon: "store", eta: "Ready in ~6 hours" },
      { id: "express_shipping", label: "Express Shipping", desc: "Priority delivery", cost: 14.99, icon: "package", eta: "Next business day" },
    ];
  }
  return [
    { id: "standard_shipping", label: "Standard Shipping", desc: "Australia Post standard", cost: 9.99, icon: "truck", eta: "3-7 business days" },
    { id: "express_shipping", label: "Express Shipping", desc: "Australia Post express", cost: 14.99, icon: "package", eta: "1-3 business days" },
  ];
}

export default function Checkout() {
  const { items, subtotal, clearCart } = useCart();
  const navigate = useNavigate();
  const [step, setStep] = useState<"shipping" | "delivery" | "payment">("shipping");
  const [paymentError, setPaymentError] = useState("");
  const [shipping, setShipping] = useState({ name: "", email: "", phone: "", address1: "", address2: "", city: "", state: "", postcode: "", country: "Australia" });
  const [notes, setNotes] = useState("");
  const [deliveryMethod, setDeliveryMethod] = useState("standard_shipping");
  const [preferredPickupTime, setPreferredPickupTime] = useState("");

  const deliveryOptions = getDeliveryOptions(shipping.postcode);
  const selectedOption = deliveryOptions.find(o => o.id === deliveryMethod) || deliveryOptions[0];
  const shippingCost = selectedOption?.cost ?? 9.99;
  const gst = Math.round((subtotal / 11) * 100) / 100;
  const total = Math.round((subtotal + shippingCost) * 100) / 100;

  useEffect(() => { if (shipping.postcode === "4870") setDeliveryMethod("free_local"); }, [shipping.postcode]);

  const createOrder = trpc.order.create.useMutation();
  const processPayment = trpc.order.processPayment.useMutation();

  const handleShippingSubmit = (e: React.FormEvent) => { e.preventDefault(); setPaymentError(""); setStep("delivery"); };
  const handleDeliverySubmit = () => { setPaymentError(""); setStep("payment"); };

  const handlePaymentSuccess = async (sourceId: string) => {
    setPaymentError("");
    try {
      const result = await createOrder.mutateAsync({
        items: items.map(i => ({ productId: i.productId, quantity: i.quantity, size: i.size, color: i.color })),
        shipping, notes: notes || undefined,
        deliveryMethod: deliveryMethod as any, deliveryInstructions: notes || undefined, preferredPickupTime: preferredPickupTime || undefined,
      });
      await processPayment.mutateAsync({ orderId: result.order.id, sourceId, amount: total });
      clearCart();
      navigate("/order-confirmation?order=" + result.order.orderNumber + "&email=" + encodeURIComponent(shipping.email));
    } catch (err: any) { setPaymentError(err.message || "Payment failed"); }
  };

  if (items.length === 0) return <div className="min-h-screen bg-[#0B1120] text-white flex flex-col items-center justify-center gap-4"><p>Your cart is empty</p><button onClick={() => navigate("/shop")} className="text-[#D4A03C] underline">Continue Shopping</button></div>;

  const IconMap: Record<string, React.ReactNode> = { truck: <Truck className="w-5 h-5" />, store: <Store className="w-5 h-5" />, package: <Package className="w-5 h-5" /> };

  return (
    <div className="min-h-screen bg-[#0B1120] text-white pb-8">
      <div>
        <button onClick={() => { if (step === "delivery") setStep("shipping"); else if (step === "payment") setStep("delivery"); else navigate(-1); }}><ArrowLeft /></button>
        <h1>Checkout</h1><Lock />
      </div>
      <div>
        {step === "shipping" && <form onSubmit={handleShippingSubmit}>
          <div><CreditCard /><span>Shippping Details</span></div>
          <input placeholder="Full Name *" required value={shipping.name} onChange={e=>setShipping({...shipping,name:e.target.value})} />
          <input type="email" placeholder="Email *" required value={shipping.email} onChange={e=>setShipping({...shipping,email:e.target.value})} />
          <input type="tel" placeholder="Phone" value={shipping.phone} onChange={e=>setShipping({...shipping,phone:e.target.value})} />
          <input placeholder="Address Line 1 *" required value={shipping.address1} onChange={e=>setShipping({...shipping,address1:e.target.value})} />
          <input placeholder="Address Line 2" value={shipping.address2} onChange={e=>setShipping({...shipping,address2:e.target.value})} />
          <input placeholder="City *" required value={shipping.city} onChange={e=>setShipping({...shipping,city:e.target.value})} />
          <input placeholder="State *" required value={shipping.state} onChange={e=>setShipping({...shipping,state:e.target.value})} />
          <input placeholder="Postcode *" required value={shipping.postcode} onChange={e=>setShipping({...shippinf¬postcode:e.target.value})} />
          <select value={shipping.country} onChange={e=>setShipping({...shipping,country:e.target.value})}><option>Australia</option></select>
          <textarea value={notes} onChange={e=>setNotes(e.target.value)} placeholder="Delivery instructions"></textarea>
          <button type="submit">Continue to Delivery Options</button>
        </form>}
        {step === "delivery" && <div>
          <div><Truck /><span>Delivery Options</span></div>
          <p>Delivering to: {shipping.postcode}</p>
          {shipping.postcode === "4870" && <div>You qualify for free Cairns delivery!</div>}
          <div>
            {deliveryOptions.map(opt => <button key={opt.id} onClick={()=>setDeliveryMethod(opt.id)}>
              <div>{IconMap[opt.icon}}</div>
              <div><p>{opt.label}</p><p>{opt.desc}</p><p>{opt.eta}</p></div>
              <span>{opt.cost === 0 ? "FREE" : `$${opt.cost.toFixed(2)}`}</span>
            </button>)}
          </div>
          {deliveryMethod === "click_collect" && <div>
            <p>Pick-up Location: 22 Craven Street, Redlynch, QLD 4870</p>
            <p>Ready in ~6 hours</p>
            <select value={preferredPickupTime} onChange={e=>setPreferredPickupTime(e.target.value)}>
              <option value="">Preferred pick-up time</option>
              <option value="morning">Morning (9am - 12pm)</option>
              <option value="afternoon">Afternoon (12pm - 4pm)</option>
              <option value="evening">Evening (4pm - 7pm)</option>
            </select>
          </div>}
          <div>
            <p>Order Summary</p>
            <span>{items.length} items</span><span>${subtotal.toFixed(2)}</span>
            <span>{selectedOption?.label}</span><span>{shippingCost === 0 ? "FREE" : `$${shippingCost.toFixed(2)}`}</span>
            <span>Total: ${total.toFixed(2)}</span>
          </div>
          <button onClick={handleDeliverySubmit}>Continue to Payment</button>
          <button onClick={()=>setStep("shipping")}>Back to Shipping</button>
        </div>}
        {step === "payment" && <div>
          <div><Lock /><span>Secure Payment</span></div>
          <SquarePaymentForm amount={total} postalCode={shipping.postcode} onPaymentSuccess={handlePaymentSuccess} onPaymentError={setPaymentError} />
          {paymentError && <div><AlertCircle />{paymentError}</div>}
          <button onClick={()=>setStep("delivery")}>Back to Delivery</button>
        </div>}
      </div>
    </div>
  );
}
